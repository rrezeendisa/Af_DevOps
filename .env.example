# Modelo de variáveis do ambiente integrado (docker-compose.yml).
# NÃO coloque valores reais aqui. Gere o .env local com:
#   ./scripts/gerar-env.sh
# ou copie este arquivo para .env e preencha os valores manualmente.
#
# Atenção: hashes BCrypt contêm "$". No .env, mantenha-os entre aspas
# simples para que o Docker Compose não tente interpolar o valor.
# Use senhas sem caracteres especiais de URL (ex.: hexadecimal), pois a
# senha do RabbitMQ também compõe a RABBITMQ_URL do worker.

# PostgreSQL (somente na rede interna do Compose)
DB_NAME=afdevops
DB_USERNAME=afdevops
DB_PASSWORD=

# RabbitMQ (usuário administrador do broker)
RABBITMQ_USER=afdevops
RABBITMQ_PASSWORD=

# Token compartilhado apenas entre backend, ai-service e worker
INTERNAL_API_TOKEN=

# Contas de demonstração do backend (veja backend/README.md)
AFDEVOPS_ADMIN_USERNAME=
AFDEVOPS_ADMIN_PASSWORD_HASH=''
AFDEVOPS_COLABORADOR_USERNAME=
AFDEVOPS_COLABORADOR_PASSWORD_HASH=''

# Sessão do navegador (opcional). SESSION_COOKIE_SECURE=true exige acesso por HTTPS.
# SESSION_COOKIE_SECURE=false
# SESSION_TIMEOUT=30m

# Limite de login no gateway, por endereço de origem (opcional)
# LOGIN_RATE=10r/s
# LOGIN_BURST=50

# Worker: repetições além da tentativa inicial
MAX_MESSAGE_RETRIES=3

# Porta padrão da Evolia em 127.0.0.1 (opcional)
# GATEWAY_PORT=8088

# Apenas com compose.diagnostico.yml
# BACKEND_PORT=8080
# AI_SERVICE_PORT=8000
# RABBITMQ_MANAGEMENT_PORT=15672

# Geração complementar no ambiente integrado
# IA_GENERATIVA_HABILITADA=true
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_TIMEOUT=PT60S
