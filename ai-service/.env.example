# URL AMQP do broker RabbitMQ; substitua pelo ambiente da Frente C.
RABBITMQ_URL=amqp://user:password@localhost:5672/%2F

# Endereço do backend Java e token compartilhado apenas entre serviços.
JAVA_BACKEND_URL=http://localhost:8080
INTERNAL_API_TOKEN=replace-with-a-shared-secret

# Caminhos relativos à pasta ai-service quando usados sem caminho absoluto.
MODEL_PATH=ml/artifacts/classifier.joblib
TRAINING_RESULT_PATH=ml/artifacts/training-results.json

# Número de repetições além da tentativa inicial.
MAX_MESSAGE_RETRIES=3
